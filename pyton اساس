# --- تعريف مسار تسجيل البريد الإلكتروني ---

@app.route('/subscribe', methods=['POST'])
def subscribe():
    """يستقبل طلب تسجيل البريد الإلكتروني ويحفظه"""
    # احصل على البريد الإلكتروني من الطلب
    email = request.json.get('email')

    if not email:
        return jsonify({'success': False, 'message': 'البريد الإلكتروني مطلوب.'}), 400

    try:
        # افتح ملف CSV في وضع الإضافة (append)
        with open('subscriptions.csv', 'a', newline='', encoding='utf-8') as file:
            writer = csv.writer(file)
            # احصل على الوقت الحالي
            timestamp = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
            # اكتب البريد الإلكتروني والوقت في الملف
            writer.writerow([email, timestamp])
        
        # أرسل ردًا ناجحًا
        return jsonify({'success': True, 'message': 'شكرًا لك، تم تسجيل بريدك الإلكتروني بنجاح!'})
    except Exception as e:
        # في حالة حدوث خطأ، أرسل رسالة خطأ
        print(f"Error: {e}")
        return jsonify({'success': False, 'message': 'حدث خطأ أثناء التسجيل. يرجى المحاولة مرة أخرى.'}), 500


