:root {
    --primary-color: #007bff;
    --secondary-color: #0a192f;
    --background-color: #ffffff;
    --text-color: #333;
    --light-gray: #f8f9fa;
    --shadow: 0 10px 30px -15px rgba(0, 0, 0, 0.2);
    --border-radius: 12px;
}

body {
    font-family: 'Tajawal', sans-serif;
    background-color: var(--background-color);
    margin: 0;
    padding: 0;
    text-align: right;
    color: var(--text-color);
    line-height: 1.7;
}

.container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 80px 20px;
}

/* Hero Header */
.hero {
    background: linear-gradient(rgba(10, 25, 47, 0.7), rgba(10, 25, 47, 0.7)), url('https://github.com/BOUKHAM/my-3D-DESIGN-portfolio/blob/main/DSRRF.jpg?raw=true') no-repeat center center/cover;
    color: white;
    height: 60vh;
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
    position: relative;
}

.hero-content h1 {
    font-size: 3.5em;
    font-weight: 800;
    margin: 0;
}

.hero-content p {
    font-size: 1.5em;
    margin-top: 10px;
}

/* Animations */
.fade-in {
    animation: fadeIn 1s ease-in-out forwards;
}

.fade-in-delay {
    animation: fadeIn 1s 0.5s ease-in-out forwards;
    opacity: 0;
}

@keyframes fadeIn {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
}

.reveal {
    opacity: 0;
    transform: translateY(50px);
    transition: opacity 0.8s ease-out, transform 0.8s ease-out;
}

.reveal.active {
    opacity: 1;
    transform: translateY(0);
}

/* General Sections */
section h2 {
    text-align: center;
    font-size: 2.5em;
    margin-bottom: 50px;
    color: var(--secondary-color);
    position: relative;
}

section h2::after {
    content: '';
    display: block;
    width: 60px;
    height: 4px;
    background: var(--primary-color);
    margin: 15px auto 0;
    border-radius: 2px;
}

/* Gallery Styles */
.gallery {
    display: grid;
    /* استخدمنا minmax لتكون الأعمدة أكثر مرونة */
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 30px;
}

.gallery-item {
    background: white;
    border-radius: var(--border-radius);
    overflow: hidden;
    box-shadow: var(--shadow);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    cursor: pointer;
}

.gallery-item:hover {
    transform: translateY(-10px);
    box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.3);
}

.gallery-item img {
    width: 100%;
    display: block;
    object-fit: cover; /* تضمن أن الصورة تملأ المساحة دون تشويه */
    
    /* --- التحسين الأساسي هنا --- */
    /* لقد أزلنا الارتفاع الثابت وأضفنا نسبة العرض إلى الارتفاع */
    /* height: 220px; */ /* <-- تم حذف هذا السطر */
    aspect-ratio: 4 / 3; /* <-- هذا هو السطر الجديد. يحافظ على نسبة 4:3 للصورة */
}

.gallery-item figcaption {
    padding: 15px;
    font-weight: 700;
    text-align: center;
}

/* Contact and Social Links */
#contact {
    background-color: var(--light-gray);
    text-align: center;
}

.social-links {
    margin-top: 30px;
    display: flex;
    justify-content: center;
    gap: 20px;
}

.social-links a {
    color: var(--secondary-color);
    font-size: 24px;
    text-decoration: none;
    background: white;
    width: 50px;
    height: 50px;
    border-radius: 50%;
    display: flex;
    justify-content: center;
    align-items: center;
    box-shadow: var(--shadow);
    transition: color 0.3s, transform 0.3s;
}

.social-links a:hover {
    color: var(--primary-color);
    transform: translateY(-5px);
}

/* Footer */
footer {
    background-color: var(--secondary-color);
    color: white;
    text-align: center;
    padding: 20px;
    font-size: 14px;
}

/* Lightbox Styles */
.lightbox {
    display: none;
    position: fixed;
    z-index: 1000;
    padding: 50px;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.9);
    justify-content: center;
    align-items: center;
}

.lightbox-content {
    max-width: 90%;
    max-height: 80vh;
    display: block;
    margin: auto;
    animation: zoomIn 0.5s ease;
}

.lightbox-caption {
    text-align: center;
    color: #ccc;
    padding: 20px 0;
    font-size: 18px;
}

.lightbox-close {
    position: absolute;
    top: 30px;
    right: 45px;
    color: #fff;
    font-size: 50px;
    font-weight: bold;
    transition: 0.3s;
    cursor: pointer;
}

.lightbox-close:hover {
    color: #bbb;
}

@keyframes zoomIn {
    from { transform: scale(0.8); opacity: 0; }
    to { transform: scale(1); opacity: 1; }
}

/* Responsive Design */
@media (max-width: 768px) {
    .hero-content h1 {
        font-size: 2.5em;
    }
    .hero-content p {
        font-size: 1.2em;
    }
    section h2 {
        font-size: 2em;
    }
    /* على الشاشات الأصغر، لا نحتاج لتغيير شيء في الجاليري لأن 
       grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
       سيقوم تلقائيًا بتحويله إلى عمود واحد عند الحاجة.
    */
}
